+#[cfg(unix)]
+#[tokio::test]
+async fn fd_pressure_pruning_keeps_recent_exited_and_all_live_processes() {
+    let (_, turn) = crate::session::tests::make_session_and_context().await;
+    let exited_process = Arc::new(
+        crate::unified_exec::process_tests::remote_process(
+            codex_exec_server::WriteStatus::Accepted,
+            /*terminate_error*/ None,
+            codex_sandboxing::SandboxType::None,
+        )
+        .await,
+    );
+    exited_process
+        .terminate_confirmed()
+        .await
+        .expect("exited process should terminate");
+    let live_process = Arc::new(
+        crate::unified_exec::process_tests::remote_process(
+            codex_exec_server::WriteStatus::Accepted,
+            /*terminate_error*/ None,
+            codex_sandboxing::SandboxType::None,
+        )
+        .await,
+    );
+    let cwd = PathUri::parse("file:///tmp").expect("test cwd should be valid");
+    let now = Instant::now();
+    let mut store = ProcessStore::default();
+
+    for process_id in 1..=12 {
+        let is_exited = process_id <= 10;
+        store.processes.insert(
+            process_id,
+            ProcessEntry {
+                process: if is_exited {
+                    Arc::clone(&exited_process)
+                } else {
+                    Arc::clone(&live_process)
+                },
+                plugin_metrics_sidecar: None,
+                call_id: format!("call-{process_id}"),
+                process_id,
+                cwd: cwd.clone(),
+                initial_exec_command_active: Arc::new(AtomicBool::new(false)),
+                hook_command: format!("command-{process_id}"),
+                tty: false,
+                environment_id: codex_exec_server::LOCAL_ENVIRONMENT_ID.to_string(),
+                permissions: super::super::TerminalPermissions::for_launch(
+                    turn.initial_environments
+                        .primary()
+                        .expect("turn environment"),
+                    &turn,
+                    super::super::TerminalSandboxSource::Native,
+                    crate::sandboxing::SandboxPermissions::UseDefault,
+                    /*additional_permissions*/ None,
+                    /*internal_permissions*/ None,
+                ),
+                network_approval: None,
+                session: std::sync::Weak::new(),
+                last_used: now - Duration::from_secs((13 - process_id) as u64),
+            },
+        );
+    }
+
+    let removed = UnifiedExecProcessManager::prune_exited_processes_for_fd_pressure(
+        &mut store,
+        /*max_retained_exited*/ 3,
+    );
+    let mut removed_ids = removed
+        .iter()
+        .map(|entry| entry.process_id)
+        .collect::<Vec<_>>();
+    removed_ids.sort_unstable();
+
+    assert_eq!(removed_ids, vec![1, 2, 3, 4, 5, 6, 7]);
+    assert_eq!(store.processes.len(), 5);
+    assert!(store.processes.contains_key(&8));
+    assert!(store.processes.contains_key(&9));
+    assert!(store.processes.contains_key(&10));
+    assert!(store.processes.contains_key(&11));
+    assert!(store.processes.contains_key(&12));
+}
