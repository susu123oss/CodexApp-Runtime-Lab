+#[cfg(target_os = "ios")]
+fn should_fallback_pty_to_pipe(error: &anyhow::Error) -> bool {
+    let roothide_deb_forkless =
+        std::env::var_os("CODEXAPP_SPAWN_EXTERNAL").as_deref() == Some(OsStr::new("1"))
+            && std::env::var_os("CA_RUNTIME_ROOT_MODE").as_deref()
+                == Some(OsStr::new("roothide"))
+            && std::env::var_os("CA_RUNTIME_INSTALL_CHANNEL").as_deref()
+                == Some(OsStr::new("deb"));
+    if !roothide_deb_forkless {
+        return false;
+    }
+    let message = error.to_string().to_ascii_lowercase();
+    message.contains("pty")
+        && (message.contains("operation not permitted") || message.contains("permission denied"))
+}
