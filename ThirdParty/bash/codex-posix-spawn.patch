+/* CODEXAPP_SPAWN_BRIDGE_V7: the CodexApp broker elevates this Bash process
+   once. Descendants inherit euid=0, so do not re-apply a root persona on each
+   posix_spawn. Repeated persona setup from an already-root shell is unstable
+   on iOS 16 when a pipeline has multiple live children. */
+static int
+codex_spawn_external_command (char *command, char **args, char **env,
+                              int pipe_in, int pipe_out,
+                              struct fd_bitmap *fds_to_close,
+                              int async, char *command_line)
+{
+  posix_spawnattr_t attr;
+  posix_spawn_file_actions_t actions;
+  sigset_t set, oset, child_mask;
+  short spawn_flags;
+  pid_t pid, current_pgrp;
+  int i, r, started_children;
+
+  if (codex_spawn_external_enabled () == 0 || command == 0 || args == 0)
+    return ENOTSUP;
+  if (interactive_shell && job_control)
+    return ENOTSUP;
+
+  sigemptyset (&set);
+  sigaddset (&set, SIGCHLD);
+  sigaddset (&set, SIGINT);
+  sigaddset (&set, SIGTERM);
+  sigprocmask (SIG_BLOCK, &set, &oset);
+  started_children = already_making_children == 0;
+  making_children ();
+
+  posix_spawnattr_init (&attr);
+  posix_spawn_file_actions_init (&actions);
+  spawn_flags = POSIX_SPAWN_SETSIGMASK;
+  child_mask = oset;
+  sigdelset (&child_mask, SIGCHLD);
+  sigdelset (&child_mask, SIGINT);
+  sigdelset (&child_mask, SIGTERM);
+  posix_spawnattr_setsigmask (&attr, &child_mask);
+  if (job_control)
+    {
+      posix_spawnattr_setpgroup (&attr, pipeline_pgrp ? pipeline_pgrp : 0);
+      spawn_flags |= POSIX_SPAWN_SETPGROUP;
+    }
+  else
+    {
+      current_pgrp = getpgrp ();
+      if (current_pgrp > 0)
+        {
+          posix_spawnattr_setpgroup (&attr, current_pgrp);
+          spawn_flags |= POSIX_SPAWN_SETPGROUP;
+        }
+    }
+  posix_spawnattr_setflags (&attr, spawn_flags);
+
+  if (pipe_in != NO_PIPE)
+    {
+      posix_spawn_file_actions_adddup2 (&actions, pipe_in, 0);
+      if (pipe_in > 0)
+        posix_spawn_file_actions_addclose (&actions, pipe_in);
+    }
+  if (pipe_out != NO_PIPE)
+    {
+      if (pipe_out != REDIRECT_BOTH)
+        {
+          posix_spawn_file_actions_adddup2 (&actions, pipe_out, 1);
+          if (pipe_out == 0 || pipe_out > 1)
+            posix_spawn_file_actions_addclose (&actions, pipe_out);
+        }
+      else
+        posix_spawn_file_actions_adddup2 (&actions, 1, 2);
+    }
+  if (fds_to_close)
+    for (i = 0; i < fds_to_close->size; i++)
+      if (fds_to_close->bitmap[i] && i != pipe_in && i != pipe_out)
+        posix_spawn_file_actions_addclose (&actions, i);
+
+  r = posix_spawn (&pid, command, &actions, &attr, args, env);
+  posix_spawn_file_actions_destroy (&actions);
+  posix_spawnattr_destroy (&attr);
+
+  if (r == 0)
+    {
+      register_spawned_child (savestring (command_line ? command_line : command),
+                              pid, async ? FORK_ASYNC : FORK_SYNC);
+    }
+  else if (started_children)
+    stop_making_children ();
+
+  sigprocmask (SIG_SETMASK, &oset, (sigset_t *)NULL);
+  return r;
+}
+
+/* CODEXAPP_SPAWN_REDIRECT_PIPE_V7: for a redirected foreground pipeline
+   stage, Bash's normal child order is:
+
+     1. connect pipe stdin/stdout
+     2. apply the command's explicit redirections
+     3. exec
+
+   Pure TrollStore cannot rely on the fork() path that normally provides that
+   child context. Temporarily reproduce steps 1 and 2 in the parent, spawn the
+   child inheriting the resulting stdio, then restore the parent immediately.
+   Raw pipe descriptors remain open in the parent; the spawned child closes its
+   copies through fds_to_close. */
+static int
+codex_save_parent_fd (int fd)
+{
+  int saved;
+
+  saved = fcntl (fd, F_DUPFD_CLOEXEC, 10);
+  if (saved >= 0)
+    return saved;
+  if (errno == EBADF)
+    return -2;  /* Original descriptor was closed. */
+  return -3;
+}
+
+static void
+codex_restore_parent_fd (int fd, int saved)
+{
+  if (saved >= 0)
+    {
+      dup2 (saved, fd);
+      close (saved);
+    }
+  else if (saved == -2)
+    close (fd);
+}
+
+static int
+codex_apply_pipeline_parent (int pipe_in, int pipe_out,
+                             int *saved_stdin, int *saved_stdout,
+                             int *saved_stderr)
+{
+  *saved_stdin = *saved_stdout = *saved_stderr = -1;
+
+  if (pipe_in != NO_PIPE)
+    {
+      *saved_stdin = codex_save_parent_fd (0);
+      if (*saved_stdin == -3 || dup2 (pipe_in, 0) < 0)
+        return -1;
+    }
+  if (pipe_out != NO_PIPE)
+    {
+      if (pipe_out != REDIRECT_BOTH)
+        {
+          *saved_stdout = codex_save_parent_fd (1);
+          if (*saved_stdout == -3 || dup2 (pipe_out, 1) < 0)
+            return -1;
+        }
+      else
+        {
+          *saved_stderr = codex_save_parent_fd (2);
+          if (*saved_stderr == -3 || dup2 (1, 2) < 0)
+            return -1;
+        }
+    }
+  return 0;
+}
+
+static void
+codex_restore_pipeline_parent (int saved_stdin, int saved_stdout,
+                               int saved_stderr)
+{
+  codex_restore_parent_fd (2, saved_stderr);
+  codex_restore_parent_fd (1, saved_stdout);
+  codex_restore_parent_fd (0, saved_stdin);
+}
